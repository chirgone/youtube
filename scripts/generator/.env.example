# Groq API Key (free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Output directory for generated scripts
OUTPUT_DIR=./generated

# Curriculum source (path to curriculum JSON)
CURRICULUM_PATH=../../curriculum/2026-q1.json

# Number of scripts to generate per batch
BATCH_SIZE=5

# Groq model to use
MODEL=llama-3.3-70b-versatile

# Max tokens per script (600-800 chars = ~150-200 tokens)
MAX_TOKENS=1000
